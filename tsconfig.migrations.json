{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "noEmit": false,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["typeorm.config.ts", "migrations/**/*.ts", "entities/**/*.ts", "lib/**/*.ts"],
  "exclude": ["node_modules", ".next", "app", "components", "hooks", "actions", "validations", "types"]
}
