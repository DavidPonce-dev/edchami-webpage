# ============================================
# Application
# ============================================
NODE_ENV=production
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ============================================
# Auth / Security (REQUIRED)
# ============================================
# Generar con: openssl rand -base64 32
JWT_SECRET=
JWT_REFRESH_SECRET=

# ============================================
# PostgreSQL Database
# ============================================
# Solo DB_PASSWORD es requerida (no tiene default seguro)
# El resto tiene defaults razonables para Docker local
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=edchami_dev

# ============================================
# Discord Bot (opcional)
# ============================================
DISCORD_BOT_URL=http://localhost:3002
DISCORD_BOT_TOKEN=

# ============================================
# SEO (opcional)
# ============================================
GOOGLE_SITE_VERIFICATION=
