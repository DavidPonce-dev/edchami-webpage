# ============================================
# Application
# ============================================
NODE_ENV=production

# Base URL pública de la aplicación (client-accessible)
# Usada en metadata, sitemap, SEO schemas
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ============================================
# Auth / Security
# ============================================
# REQUIRED: Secret para firmar/verificar JWT tokens
# Generar con: openssl rand -base64 32
JWT_SECRET=change-me-in-production

# Secret para refresh tokens (opcional pero recomendado rotar)
JWT_REFRESH_SECRET=change-me-in-production

# ============================================
# PostgreSQL Database
# ============================================
# Opción A: URL completa (Coolify genera esta automáticamente)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Opción B: Variables individuales (usar si no hay DATABASE_URL)
# La app soporta ambos prefijos: DB_* y POSTGRES_*
# Coolify inyecta POSTGRES_* por defecto

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=edchami_dev

# Alternativas para compatibilidad con Coolify/PaaS
# (la app usa DB_* o POSTGRES_*, lo que esté disponible)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=edchami_dev

# ============================================
# Discord Bot (servicio externo opcional)
# ============================================
DISCORD_BOT_URL=http://localhost:3002
DISCORD_BOT_TOKEN=

# ============================================
# SEO / Integraciones
# ============================================
# Google Search Console verification token
GOOGLE_SITE_VERIFICATION=
